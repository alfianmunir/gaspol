# Edge Function secrets — set with `supabase secrets set KEY=value`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# by the platform at runtime; you do NOT set them here.

# Claude API key (server-side only — never ship to the browser).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Shared secret the scheduler sends as x-cron-secret to fit-weekly-review.
CRON_SECRET=generate-a-long-random-string

# Optional model overrides (defaults in _shared/claude.ts).
# GASPOL_REVIEW_MODEL=claude-sonnet-5
# GASPOL_VISION_MODEL=claude-haiku-4-5-20251001
